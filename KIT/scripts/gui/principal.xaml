<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KIT SERVICIO" Width="1180" Height="700" MinWidth="980" MinHeight="600"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14" Background="#F6F8FA">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="14,4"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="Background" Value="#FFFFFF"/>
      <Setter Property="BorderBrush" Value="#C9D1D9"/>
    </Style>
    <Style x:Key="Primario" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#0B6BCB"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderBrush" Value="#0B6BCB"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Paso" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Margin" Value="0,0,6,0"/>
      <Setter Property="MinWidth" Value="96"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0,0,0,3"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
    </Style>
    <Style x:Key="Tarjeta" TargetType="ToggleButton">
      <Setter Property="Width" Value="240"/>
      <Setter Property="Height" Value="130"/>
      <Setter Property="Margin" Value="0,0,14,14"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#C9D1D9"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="VerticalContentAlignment" Value="Top"/>
      <Setter Property="Padding" Value="14"/>
      <Style.Triggers>
        <Trigger Property="IsChecked" Value="True">
          <Setter Property="BorderBrush" Value="#0B6BCB"/>
          <Setter Property="Background" Value="#DDF4FF"/>
        </Trigger>
      </Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Padding" Value="4,3"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="ComboBox">
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style TargetType="CheckBox">
      <Setter Property="Margin" Value="0,4,14,8"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>
    <Style TargetType="GroupBox">
      <Setter Property="Margin" Value="0,0,0,12"/>
      <Setter Property="Padding" Value="10"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="#D0D7DE"/>
    </Style>
    <Style x:Key="Etiqueta" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#57606A"/>
      <Setter Property="Margin" Value="0,0,0,2"/>
    </Style>
    <Style x:Key="Titulo" TargetType="TextBlock">
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="#0B3D75"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
  </Window.Resources>

  <DockPanel>
    <!-- Barra superior: equipo, serie, admin y cliente -->
    <Border Name="bdBarra" DockPanel.Dock="Top" Background="#0B3D75" Padding="14,8">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
          <Border Name="bdAdmin" CornerRadius="10" Padding="10,2" Margin="0,0,10,0" Background="#D4A72C">
            <TextBlock Name="txtAdmin" Text="Admin: no" Foreground="Black" FontWeight="SemiBold"/>
          </Border>
          <Button Name="btnVolverEquipo" Content="Volver a este equipo" Margin="0,0,8,0" MinHeight="30" Visibility="Collapsed"/>
          <Button Name="btnRelanzar" Content="Relanzar como admin" Margin="0" MinHeight="30"/>
        </StackPanel>
        <StackPanel>
          <TextBlock Name="txtEquipo" Text="Equipo" Foreground="White" FontSize="17" FontWeight="SemiBold"/>
          <TextBlock Name="txtCliente" Text="" Foreground="#C8E1FF" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Pasos -->
    <Border DockPanel.Dock="Top" Background="White" BorderBrush="#D0D7DE" BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <Button Name="navExpedientes" Content="Expedientes" Style="{StaticResource Paso}"/>
          <Button Name="navCliente" Content="Mostrar al cliente" Style="{StaticResource Paso}"/>
          <Button Name="navTecnico" Content="Modo técnico" Style="{StaticResource Paso}"/>
          <Button Name="navHerramientas" Content="Herramientas" Style="{StaticResource Paso}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
          <Button Name="navInicio" Content="Inicio" Style="{StaticResource Paso}"/>
          <Button Name="navFicha" Content="① Ficha" Style="{StaticResource Paso}"/>
          <Button Name="navAntes" Content="② Antes" Style="{StaticResource Paso}"/>
          <Button Name="navTrabajo" Content="③ Trabajo" Style="{StaticResource Paso}"/>
          <Button Name="navDespues" Content="④ Después" Style="{StaticResource Paso}"/>
          <Button Name="navInforme" Content="⑤ Informe" Style="{StaticResource Paso}"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Barra inferior: trabajo en segundo plano -->
    <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#D0D7DE" BorderThickness="0,1,0,0" Padding="12,6">
      <DockPanel>
        <Button Name="btnCancelar" DockPanel.Dock="Right" Content="Cancelar" Margin="0" Visibility="Collapsed"/>
        <ProgressBar Name="prgTarea" DockPanel.Dock="Right" Width="220" Height="14" Margin="0,0,12,0" Visibility="Collapsed"/>
        <TextBlock Name="txtEstado" VerticalAlignment="Center" Text="Listo." TextTrimming="CharacterEllipsis"/>
      </DockPanel>
    </Border>

    <Grid Margin="18,14,18,8">
      <!-- INICIO -->
      <ScrollViewer Name="pnlInicio" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="¿Por qué viene el equipo?" Style="{StaticResource Titulo}"/>
          <TextBlock Text="Puedes marcar más de uno." Style="{StaticResource Etiqueta}" Margin="0,-8,0,12"/>
          <WrapPanel>
            <ToggleButton Name="tgCalor" Style="{StaticResource Tarjeta}">
              <StackPanel><TextBlock Text="Se calienta / hace ruido" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Se apaga, baja los FPS, ventilador fuerte" Foreground="#57606A" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton Name="tgLento" Style="{StaticResource Tarjeta}">
              <StackPanel><TextBlock Text="Está lento" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Arranca lento, se pega, mucha RAM o CPU" Foreground="#57606A" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton Name="tgArchivos" Style="{StaticResource Tarjeta}">
              <StackPanel><TextBlock Text="Archivos y espacio" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Sin espacio, duplicados, desorden" Foreground="#57606A" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </ToggleButton>
            <ToggleButton Name="tgRevision" Style="{StaticResource Tarjeta}">
              <StackPanel><TextBlock Text="Revisión completa" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Solo diagnóstico del estado general" Foreground="#57606A" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel>
            </ToggleButton>
          </WrapPanel>
          <TextBlock Text="Avance de la atención" FontSize="16" FontWeight="SemiBold" Margin="0,10,0,8"/>
          <WrapPanel Name="wpPasos"/>
          <TextBlock Name="txtAtencion" Style="{StaticResource Etiqueta}" Margin="0,10,0,0" TextWrapping="Wrap"/>
        </StackPanel>
      </ScrollViewer>

      <!-- FICHA -->
      <ScrollViewer Name="pnlFicha" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
          <TextBlock Text="① Ficha del cliente" Style="{StaticResource Titulo}"/>
          <TextBlock Text="* obligatorio para los informes. Solo nombre, contacto y comuna: nada de RUT ni dirección." Style="{StaticResource Etiqueta}" Margin="0,-8,0,10"/>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
              <TextBlock Text="Nombre *" Style="{StaticResource Etiqueta}"/><TextBox Name="txtNombre"/>
              <TextBlock Text="Contacto * (WhatsApp o correo)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtContacto"/>
              <TextBlock Text="Comuna" Style="{StaticResource Etiqueta}"/><TextBox Name="txtComuna"/>
              <TextBlock Text="Síntoma * (en palabras del cliente)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtSintoma" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
              <TextBlock Text="Estado físico (golpes, piezas sueltas...)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtEstadoFisico"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
              <TextBlock Text="Paquete *" Style="{StaticResource Etiqueta}"/><TextBox Name="txtPaquete"/>
              <TextBlock Text="Precio * (pesos)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtPrecio"/>
              <TextBlock Text="¿Tiene respaldo de sus archivos?" Style="{StaticResource Etiqueta}"/>
              <ComboBox Name="cmbRespaldo"><ComboBoxItem Content=""/><ComboBoxItem Content="sí"/><ComboBoxItem Content="no"/><ComboBoxItem Content="no sabe"/></ComboBox>
              <CheckBox Name="chkClaveBitlocker" Content="Clave de recuperación de BitLocker confirmada"/>
              <TextBlock Text="Notas" Style="{StaticResource Etiqueta}"/><TextBox Name="txtNotas" Height="60" TextWrapping="Wrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
            </StackPanel>
          </Grid>
          <GroupBox Header="Checklist funcional (al recibir el equipo)">
            <UniformGrid Name="ugChecklist" Columns="5"/>
          </GroupBox>
          <GroupBox Name="grpFichaArchivos" Header="Archivos (obligatorio con este motivo)">
            <StackPanel>
              <TextBlock Text="Consentimiento del cliente *" Style="{StaticResource Etiqueta}"/>
              <ComboBox Name="cmbConsentimiento" Width="420" HorizontalAlignment="Left"><ComboBoxItem Content=""/><ComboBoxItem Content="solo leer (solo reporte)"/><ComboBoxItem Content="mover a _PARA_BORRAR"/><ComboBoxItem Content="borrar aprobado (igual se mueve, nunca se borra)"/></ComboBox>
              <TextBlock Text="Carpetas protegidas * (una por línea; nunca se tocan)" Style="{StaticResource Etiqueta}"/>
              <TextBox Name="txtProtegidas" Height="64" TextWrapping="NoWrap" AcceptsReturn="True" VerticalContentAlignment="Top"/>
            </StackPanel>
          </GroupBox>
          <WrapPanel>
            <Button Name="btnGuardarFicha" Content="Guardar ficha" Style="{StaticResource Primario}"/>
            <Button Name="btnFotos" Content="Agregar fotos de recepción..."/>
            <Button Name="btnEntregado" Content="Marcar entregado hoy"/>
          </WrapPanel>
          <TextBlock Name="txtFichaEstado" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>
      </ScrollViewer>

      <!-- ANTES / DESPUÉS -->
      <Grid Name="pnlMedicion" Visibility="Collapsed">
        <Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
        <DockPanel Grid.Column="0">
          <TextBlock Name="txtMedicionTitulo" DockPanel.Dock="Top" Text="② Antes" Style="{StaticResource Titulo}"/>
          <WrapPanel DockPanel.Dock="Top">
            <Button Name="btnDiagnosticar" Content="Diagnosticar" Style="{StaticResource Primario}"/>
            <Button Name="btnPreInforme" Content="Ver pre-informe"/>
            <CheckBox Name="chkEspacio" Content="Incluir recorrido de carpetas (hasta 3 min más)"/>
          </WrapPanel>
          <TextBlock Name="txtMedicionEstado" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,6"/>
          <ProgressBar Name="prgDiag" DockPanel.Dock="Top" Height="10" Maximum="13" Margin="0,0,0,8"/>
          <TextBlock DockPanel.Dock="Top" Text="Alertas (doble clic para ver el detalle)" Style="{StaticResource Etiqueta}"/>
          <ListBox Name="lstAlertas" DockPanel.Dock="Top" Height="190" Margin="0,0,0,8">
            <ListBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Linea}" Foreground="{Binding Color}" TextTrimming="CharacterEllipsis"/></DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
          <TextBlock DockPanel.Dock="Top" Text="Registro" Style="{StaticResource Etiqueta}"/>
          <TextBox Name="txtLog" IsReadOnly="True" FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" VerticalContentAlignment="Top" Margin="0"/>
        </DockPanel>
        <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel Name="spCalorMedicion">
            <GroupBox Header="CALOR: sensores bajo carga">
              <StackPanel>
                <Button Name="btnImportarCsv" Content="Importar CSV de sensores..." HorizontalAlignment="Left"/>
                <TextBlock Name="txtSensores" TextWrapping="Wrap" Foreground="#57606A"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="CALOR: condiciones de la medición *">
              <StackPanel>
                <TextBlock Text="Enchufado" Style="{StaticResource Etiqueta}"/>
                <ComboBox Name="cmbEnchufado"><ComboBoxItem Content=""/><ComboBoxItem Content="sí"/><ComboBoxItem Content="no"/></ComboBox>
                <TextBlock Text="Plan de energía" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondPlan"/>
                <TextBlock Text="Modo de ventiladores" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondVentiladores"/>
                <TextBlock Text="Superficie" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondSuperficie"/>
                <TextBlock Text="Temperatura ambiente (°C)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondAmbiente"/>
                <TextBlock Text="Tipo de carga" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondCarga"/>
                <TextBlock Text="Duración de la carga (minutos)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtCondDuracion"/>
                <Button Name="btnGuardarCondiciones" Content="Guardar condiciones" HorizontalAlignment="Left"/>
                <TextBlock Name="txtCondEstado" TextWrapping="Wrap"/>
              </StackPanel>
            </GroupBox>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- TRABAJO -->
      <ScrollViewer Name="pnlTrabajo" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="③ Trabajo" Style="{StaticResource Titulo}"/>
          <GroupBox Name="grpTrabajoCalor" Header="CALOR: checklist físico y materiales">
            <StackPanel>
              <WrapPanel>
                <CheckBox Name="chkDesarme" Content="Desarme"/><CheckBox Name="chkLimpieza" Content="Limpieza"/>
                <CheckBox Name="chkFotosAntes" Content="Fotos del disipador antes"/><CheckBox Name="chkFotosDespues" Content="Fotos del disipador después"/>
              </WrapPanel>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0"><TextBlock Text="Pasta térmica o PTM" Style="{StaticResource Etiqueta}"/><TextBox Name="txtPasta"/></StackPanel>
                <StackPanel Grid.Column="2"><TextBlock Text="Putty o pads" Style="{StaticResource Etiqueta}"/><TextBox Name="txtPutty"/></StackPanel>
              </Grid>
              <TextBlock Text="Materiales (separados por ;)" Style="{StaticResource Etiqueta}"/><TextBox Name="txtMateriales"/>
              <Button Name="btnGuardarChecklist" Content="Guardar checklist" HorizontalAlignment="Left"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Name="grpTrabajoLento" Header="LENTO: acciones sugeridas (ninguna viene marcada)">
            <StackPanel>
              <WrapPanel>
                <Button Name="btnBuscarAcciones" Content="Ver acciones sugeridas"/>
                <Button Name="btnAplicarAcciones" Content="Aplicar seleccionadas..." Style="{StaticResource Primario}"/>
                <Button Name="btnDeshacerLento" Content="Deshacer acciones aplicadas"/>
              </WrapPanel>
              <DataGrid Name="dgAcciones" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="280" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Aplicar" Binding="{Binding Aplicar, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                  <DataGridTextColumn Header="Acción" Binding="{Binding Titulo}" IsReadOnly="True" Width="2*"/>
                  <DataGridTextColumn Header="Qué hace / cómo se deshace" Binding="{Binding Detalle}" IsReadOnly="True" Width="2*"/>
                  <DataGridTextColumn Header="Ojo" Binding="{Binding Marcas}" IsReadOnly="True" Width="110"/>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Name="txtLento" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </GroupBox>
          <GroupBox Name="grpTrabajoArchivos" Header="ARCHIVOS: analizar → revisar → mover (nunca se borra)">
            <StackPanel>
              <WrapPanel>
                <Button Name="btnAnalizar" Content="Analizar"/>
                <Button Name="btnMover" Content="Mover marcados a _PARA_BORRAR..." Style="{StaticResource Primario}"/>
                <Button Name="btnDeshacerArchivos" Content="Deshacer (devolver todo)"/>
              </WrapPanel>
              <TextBlock Name="txtArchivos" TextWrapping="Wrap" Margin="0,0,0,6"/>
              <DataGrid Name="dgArchivos" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" MaxHeight="300" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                  <DataGridCheckBoxColumn Header="Mover" Binding="{Binding Mover, UpdateSourceTrigger=PropertyChanged}" Width="64"/>
                  <DataGridTextColumn Header="Tipo" Binding="{Binding Categoria}" IsReadOnly="True" Width="140"/>
                  <DataGridTextColumn Header="Tamaño" Binding="{Binding Tamano}" IsReadOnly="True" Width="90"/>
                  <DataGridTextColumn Header="Ruta" Binding="{Binding Ruta}" IsReadOnly="True" Width="3*"/>
                  <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" IsReadOnly="True" Width="2*"/>
                </DataGrid.Columns>
              </DataGrid>
            </StackPanel>
          </GroupBox>
          <GroupBox Name="grpTrabajoRevision" Header="REVISIÓN: semáforo por área">
            <ItemsControl Name="icSemaforo">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Margin="0,2">
                    <Ellipse Width="14" Height="14" Fill="{Binding Pincel}" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding Area}" Width="180" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Frase}" TextWrapping="Wrap"/>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </GroupBox>
          <Button Name="btnTrabajoTerminado" Content="Marcar trabajo terminado" HorizontalAlignment="Left" Style="{StaticResource Primario}"/>
        </StackPanel>
      </ScrollViewer>

      <!-- INFORME -->
      <DockPanel Name="pnlInforme" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Text="⑤ Informe" Style="{StaticResource Titulo}"/>
        <WrapPanel DockPanel.Dock="Top">
          <Button Name="btnGenerar" Content="Generar informes" Style="{StaticResource Primario}"/>
          <Button Name="btnAbrirCliente" Content="Abrir informe del cliente"/>
          <Button Name="btnAbrirTecnico" Content="Abrir informe técnico"/>
          <Button Name="btnAbrirCarpeta" Content="Abrir carpeta"/>
        </WrapPanel>
        <TextBlock Name="txtInforme" DockPanel.Dock="Top" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <TabControl>
          <TabItem Header="Cliente"><WebBrowser Name="wbCliente"/></TabItem>
          <TabItem Header="Técnico"><WebBrowser Name="wbTecnico"/></TabItem>
        </TabControl>
      </DockPanel>

      <!-- MODO TÉCNICO -->
      <ScrollViewer Name="pnlTecnico" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Modo técnico" Style="{StaticResource Titulo}"/>
          <TextBlock Text="Fuera del flujo guiado. Un diagnóstico suelto abre una atención aparte para no pisar las mediciones." Style="{StaticResource Etiqueta}" TextWrapping="Wrap" Margin="0,-8,0,10"/>
          <GroupBox Header="Diagnóstico suelto">
            <StackPanel>
              <WrapPanel Name="wpSecciones"/>
              <WrapPanel>
                <Button Name="btnDiagSuelto" Content="Diagnosticar las secciones marcadas" Style="{StaticResource Primario}"/>
                <CheckBox Name="chkSueltoEspacio" Content="Con recorrido de carpetas"/>
              </WrapPanel>
            </StackPanel>
          </GroupBox>
          <GroupBox Header="Atajos">
            <WrapPanel>
              <Button Name="btnAbrirExpediente" Content="Abrir carpeta del expediente"/>
              <Button Name="btnAbrirResumen" Content="Abrir último resumen.txt"/>
              <Button Name="btnAbrirTrabajoLog" Content="Abrir trabajo.log"/>
              <Button Name="btnAbrirLeeme" Content="Abrir LEEME"/>
              <Button Name="btnConsola" Content="Menú de consola"/>
            </WrapPanel>
          </GroupBox>
        </StackPanel>
      </ScrollViewer>

      <!-- EXPEDIENTES -->
      <DockPanel Name="pnlExpedientes" Visibility="Collapsed">
        <TextBlock DockPanel.Dock="Top" Text="Expedientes" Style="{StaticResource Titulo}"/>
        <TextBlock DockPanel.Dock="Top" Text="Abre cualquier expediente para revisarlo, completar la ficha o regenerar sus informes. El de otro equipo se abre en modo consulta: no se mide ni se aplican acciones." Style="{StaticResource Etiqueta}" TextWrapping="Wrap" Margin="0,-8,0,10"/>
        <WrapPanel DockPanel.Dock="Top">
          <RadioButton Name="rbFuenteUsb" Content="En el USB" GroupName="fuente" IsChecked="True" Margin="0,6,18,8"/>
          <RadioButton Name="rbFuenteMaestro" Content="En el maestro (este PC)" GroupName="fuente" Margin="0,6,24,8"/>
          <TextBlock Text="Buscar" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <TextBox Name="txtBuscarExp" Width="240"/>
        </WrapPanel>
        <GroupBox Name="grpSincronizar" DockPanel.Dock="Bottom" Header="Sincronizar con el maestro (solo en tus equipos)">
          <StackPanel>
            <TextBlock Name="txtMaestro" TextWrapping="Wrap" Foreground="#57606A" Margin="0,0,0,6"/>
            <WrapPanel>
              <Button Name="btnSincronizar" Content="Sincronizar" Style="{StaticResource Primario}"/>
              <CheckBox Name="chkLiberarUsb" Content="Después, dejar en el USB solo las atenciones abiertas"/>
              <Button Name="btnAbrirLogSync" Content="Abrir último log"/>
            </WrapPanel>
            <TextBlock Name="txtSync" TextWrapping="Wrap"/>
          </StackPanel>
        </GroupBox>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,4">
          <TextBlock Text="Atención" Style="{StaticResource Etiqueta}" VerticalAlignment="Center" Margin="0,0,8,8"/>
          <Button Name="btnAbrirExp" DockPanel.Dock="Right" Content="Abrir" Style="{StaticResource Primario}" Margin="8,0,0,8" IsEnabled="False"/>
          <ComboBox Name="cmbAtencionExp"/>
        </DockPanel>
        <TextBlock Name="txtExpedientes" DockPanel.Dock="Bottom" Style="{StaticResource Etiqueta}" Margin="0,6,0,0"/>
        <DataGrid Name="dgExpedientes" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" SelectionMode="Single" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
          <DataGrid.Columns>
            <DataGridTextColumn Header="Cliente" Binding="{Binding Cliente}" Width="2*"/>
            <DataGridTextColumn Header="Comuna" Binding="{Binding Comuna}" Width="*"/>
            <DataGridTextColumn Header="Equipo" Binding="{Binding Equipo}" Width="2*"/>
            <DataGridTextColumn Header="Serie" Binding="{Binding Serie}" Width="*"/>
            <DataGridTextColumn Header="Atenciones" Binding="{Binding Atenciones}" Width="2*"/>
            <DataGridTextColumn Header="Última" Binding="{Binding Ultima}" Width="100"/>
          </DataGrid.Columns>
        </DataGrid>
      </DockPanel>

      <!-- HERRAMIENTAS -->
      <ScrollViewer Name="pnlHerramientas" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
        <StackPanel>
          <TextBlock Text="Herramientas" Style="{StaticResource Titulo}"/>
          <TextBlock Text="Las que no están en KIT\herramientas aparecen en gris. Se actualizan con actualizar_herramientas.ps1 en tu equipo." Style="{StaticResource Etiqueta}" TextWrapping="Wrap" Margin="0,-8,0,10"/>
          <WrapPanel Name="wpHerramientas"/>
          <TextBlock Name="txtHerramienta" TextWrapping="Wrap" Foreground="#57606A"/>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</Window>
