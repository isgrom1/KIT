# El repositorio es PÚBLICO: aquí va solo el código y la documentación del kit.

# Datos de clientes (expedientes, diagnósticos, fotos, informes): nunca al repositorio.
KIT/clientes/

# Datos propios del técnico (contacto...): van en el PC y en el pendrive, nunca al repositorio público.
KIT/scripts/config/config_local.json

# Herramientas de terceros: tienen licencias propias y pesan; las baja actualizar_herramientas.ps1.
KIT/herramientas/*
!KIT/herramientas/versiones.json
KIT/DDU/

# Vistas previas, capturas y salidas de pruebas (traen datos del equipo).
vista_previa_informe_*.pdf
capturas_fase_*/
pruebas/vista_previa/
pruebas/*.txt
pruebas/*.log

# Lo que deja actualizar_pendrive.ps1 en el pendrive (si alguna vez se corre sobre una copia dentro del repo).
KIT/version.json
KIT/_obsoletos/

# Paquetes de soporte: llevan series y registros de equipos de clientes.
KIT/soporte/

# Temporales del kit.
*.tmp
*.bak
*.sync_tmp
_gui_parametros.json
